// save-earth — FFL definitions for the environmental-action map pipeline.
//
// Mirrors the CLI surface in ``save_earth/tools/`` — each
// event facet wraps one _save_earth_tools function, handlers are thin
// dispatchers that import from _save_earth_tools/ via a sys.path shim.
// The runtime and the
// terminal produce identical outputs and share the cache rooted at
// ``$AFL_CACHE_ROOT/save-earth/``.
//
// Data sources covered in this pass:
//   - OpenLitterMap (crowd-sourced geotagged litter observations)
//   - EPA Superfund NPL + Brownfields (authoritative remediation sites)
// Later PRs can add Tree Equity Score, Open311 cleanup feeds, and
// Surfrider chapters by defining new event facets in save_earth.sources
// without touching the map-build facet.

// ---------------------------------------------------------------------------
// Schemas
// ---------------------------------------------------------------------------

namespace save_earth.types {
    /** Result of any source download — one cached GeoJSON + sidecar.
      *
      * Matches the ``FetchResult`` dataclass the _save_earth_tools modules return so
      * FFL workflows can key downstream steps on ``relative_path`` or
      * ``feature_count`` without parsing the cached file. */
    schema SourceFetchResult {
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    }

    /** Output of BuildMap: filesystem paths to the rendered bundle.
      *
      * ``layer_counts`` is ``{layer_name: feature_count}`` as a JSON
      * object so the schema stays flat even when new sources get
      * added later. */
    schema MapBundle {
        region_key: String,
        output_dir: String,
        html_path: String,
        layer_count: Int,
        layer_counts: Json
    }
}

// ---------------------------------------------------------------------------
// Shared mixins
// ---------------------------------------------------------------------------

namespace save_earth.mixins {
    /** Retry a step with exponential backoff. Applied to every
      * network-facing source download — OpenLitterMap's servers can
      * rate-limit, EPA's ArcGIS fronts occasionally 5xx. */
    facet RetryPolicy(
        max_retries: Int = 3,
        backoff_ms: Int = 2000
    ) => (max_retries: Int, backoff_ms: Int)

    implicit default_retry = RetryPolicy()
}

// ---------------------------------------------------------------------------
// Sources — one event facet per cached data source.
// ---------------------------------------------------------------------------

namespace save_earth.sources {
    use save_earth.types

    /** Download OpenLitterMap geotagged litter observations.
      *
      * ``mode = "clusters"`` (default) works at any zoom; returns
      * aggregated cluster points. ``mode = "points"`` returns
      * individual photos but the upstream server enforces
      * ``zoom >= 15`` and a bounded ``bbox``.
      *
      * ``bbox`` is a comma-separated ``min_lon,min_lat,max_lon,max_lat``
      * string (empty = no bbox). Keeping it a String avoids making
      * Json mandatory; handlers parse it at dispatch time. */
    event facet DownloadOpenLitterMap(
        mode: String = "clusters",
        zoom: Int = 4,
        bbox: String = "",
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download the EPA Toxic Release Inventory facility table.
      *
      * Fetches TRI_FACILITY from ``data.epa.gov/efservice/`` (the
      * old ``enviro.epa.gov`` URL redirects there). ~65 k rows
      * total, paginated at 10 k/request. Normalizes longitude sign
      * for western-hemisphere state codes.
      *
      * ``active_only`` (default true) drops facilities whose
      * ``fac_closed_ind`` is ``"1"``. */
    event facet DownloadTri(
        active_only: Boolean = true,
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download an EPA remediation-site dataset.
      *
      * ``dataset`` = ``"superfund"`` (NPL sites, ~1.4k) or
      * ``"brownfields"`` (ACRES, tens of thousands — paginated
      * transparently by the handler). */
    event facet DownloadEpaCleanups(
        dataset: String = "superfund",
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download worldwide nuclear power reactors & plants from OSM.
      *
      * Queries the OpenStreetMap Overpass API for every feature tagged
      * ``generator:source=nuclear`` (an individual reactor) or
      * ``plant:source=nuclear`` (a whole station), centroiding any
      * way/relation polygon to a Point. Every OSM tag is kept verbatim
      * as the feature's properties, so the map popup can surface all
      * available information (name, operator, output:electricity,
      * start_date, reactor method, status, …). Coverage and tag
      * completeness are OSM-community-driven and vary by country. */
    event facet DownloadNuclearReactors(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download worldwide heritage-named enclave neighbourhoods from OSM.
      *
      * Queries the Overpass API for named places (place=neighbourhood /
      * quarter / suburb / city_block / locality) whose NAME marks a heritage
      * enclave — Chinatown, Japantown, Little Italy, Koreatown, Little Saigon,
      * Greektown, Little Havana, … OSM has no structured ethnicity attribute
      * (demographics aren't on-the-ground verifiable), so the name is the
      * signal; each match is classified into a heritage bucket and written to
      * one GeoJSON per heritage (chinese.geojson, italian.geojson, …) so the
      * map renders one coloured, toggleable layer per heritage. Every OSM tag
      * is kept verbatim for the popup; many carry a wikidata/wikipedia link.
      * Coverage is community-driven and uneven (rich in US/European metros). */
    event facet DownloadEthnicEnclaves(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        feature_count: Int,
        heritage_count: Int,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download world power plants by source from the WRI Global Power Plant
      * Database — hydro (dams) / coal / solar / wind / nuclear, ~35k plants,
      * one GeoJSON per source. Every WRI field (name, capacity_mw, fuel,
      * commissioning year, country, owner) is kept for the popup. */
    event facet DownloadPowerPlants(
        force: Boolean = false
    ) => (
        cache_type: String,
        feature_count: Int,
        layer_count: Int,
        source_url: String
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Emit the list of tiles ("S,W,N,E" bbox strings) the ≥500 kV transmission
      * fan-out spreads over (dense continents split so no single query 504s). */
    event facet ListTransmissionTiles() => (
        tiles: Json,
        count: Int
    ) with Effect(kind = "pure") with Cost(tier = "free")

    /** Fetch ≥500 kV transmission lines for ONE bounding box ("S,W,N,E") from
      * OSM, cached as a per-tile GeoJSON. A single global query 504s, so the
      * world is tiled and these tiles run in PARALLEL (ScanTransmissionTiles). */
    event facet DownloadTransmissionTile(
        bbox: String
    ) => (
        bbox: String,
        feature_count: Int
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate") with Timeout(minutes = 15)

    /** Fan out the ≥500 kV transmission fetch across the tiles — one
      * DownloadTransmissionTile per tile, in parallel across the fleet, so a
      * region that times out retries on its own without sinking the whole fetch.
      * (A `workflow` with a foreach body — not an `event facet` — so the runtime
      * runs the fan-out rather than waiting for a handler.) */
    workflow ScanTransmissionTiles(
        tiles: Json
    ) => (
        count: Int
    ) andThen foreach tile in $.tiles {
        t = DownloadTransmissionTile(bbox = $.tile)
        yield ScanTransmissionTiles(count = 1)
    }

    /** Merge the per-tile transmission GeoJSONs into one ≥500 kV layer, deduping
      * lines that cross a tile border by OSM way id. ``dependency_signal``
      * sequences this strictly after the tile fan-out completes. */
    event facet MergeTransmission(
        tiles: Json,
        dependency_signal: Int = 0
    ) => (
        cache_type: String,
        feature_count: Int
    ) with Effect(kind = "io") with Cost(tier = "cheap")

    /** Download worldwide major (notable) volcanoes from OSM.
      *
      * Queries the OpenStreetMap Overpass API for every feature tagged
      * ``natural=volcano`` that also carries a ``wikidata`` or ``wikipedia``
      * tag — encyclopedic notability as the "major" proxy (OSM has no reliable
      * global prominence/VEI tag), yielding ~1-2k worldwide. Every OSM tag is
      * kept verbatim as the feature's properties so the map popup can surface
      * all available information (name, ele, volcano:type, volcano:status, …).
      * Coverage and tag completeness are OSM-community-driven. */
    event facet DownloadVolcanoes(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download worldwide LGBTQ+ bars & restaurants from OSM.
      *
      * Queries the OpenStreetMap Overpass API for food/drink venues (bar, pub,
      * nightclub, restaurant, cafe, fast_food, biergarten) tagged LGBTQ-oriented
      * or LGBTQ-welcoming (``lgbtq=*`` other than ``no``, or the older
      * ``gay=yes``). Every OSM tag is kept verbatim so the popup table shows all
      * available info (name, amenity, lgbtq, opening_hours, website, …). */
    event facet DownloadLgbtqVenues(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download worldwide named research telescopes from OpenStreetMap.
      *
      * Queries Overpass for named man_made=telescope (optical + radio). Every OSM
      * tag is kept verbatim; feature_kind = the telescope:type (else "telescope"). */
    event facet DownloadTelescopes(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download worldwide Tesla charging stations from OpenStreetMap.
      *
      * Queries Overpass for amenity=charging_station branded / networked /
      * operated as Tesla (or carrying a Tesla supercharger socket). Every OSM tag
      * is kept verbatim; feature_kind = supercharger | charger. */
    event facet DownloadTeslaChargers(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download recent significant earthquakes worldwide from the USGS feed.
      *
      * The default feed is magnitude 4.5+ over the past 30 days (a clean global
      * signal). Each feature is a Point with the USGS properties verbatim
      * (mag, place, time, magType, tsunami, …) plus a derived depth_km. */
    event facet DownloadEarthquakes(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download tectonic plate boundaries (the major global fault lines).
      *
      * Peter Bird (2002) PB2002 boundaries as LineString features. Plate
      * boundaries are effectively static, so this caches for a long time. */
    event facet DownloadFaults(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")
}

// ---------------------------------------------------------------------------
// Maps — stitch cached GeoJSON into a MapLibre HTML bundle.
// ---------------------------------------------------------------------------

namespace save_earth.maps {
    use save_earth.types

    /** Build a MapLibre HTML map with every cached save-earth layer.
      *
      * Auto-discovers cached files — every OpenLitterMap GeoJSON under
      * ``cache/save-earth/openlittermap/`` and every EPA dataset
      * becomes its own toggleable layer. Passing a dependency signal
      * (e.g. the ``feature_count`` from a just-finished download) lets
      * the runtime sequence the map build after the downloads it
      * relies on.
      *
      * ``basemap_url`` / ``basemap_attribution`` let the caller swap
      * the raster basemap. Default is CARTO Voyager — free, no API
      * key, works from ``file://`` (unlike tile.openstreetmap.org,
      * which requires a Referer header per its volunteer-tile
      * policy). Supports ``{z}/{x}/{y}`` plus optional ``{s}`` for
      * subdomain rotation. */
    event facet BuildMap(
        region: String = "global",
        center_lat: Double = 39.8283,
        center_lon: Double = -98.5795,
        zoom: Double = 4.0,
        basemap_url: String = "",
        basemap_attribution: String = "",
        dependency_signal: Int = 0,
        only_layers: String = "",
        attribution_workflow: String = "",
        attribution_ffl_url: String = "",
        description: String = ""
    ) => (
        region_key: String,
        output_dir: String,
        html_path: String,
        layer_count: Int,
        layer_counts: Json
    ) with Effect(kind = "io") with Cost(tier = "cheap")
}

// ---------------------------------------------------------------------------
// Workflows
// ---------------------------------------------------------------------------

namespace save_earth.workflows {
    use save_earth.types

    /** Download every source and build the combined global map.
      *
      * Downloads run in parallel (FFL ``andThen`` siblings are
      * scheduled concurrently when they don't reference each other).
      * Any download failure yields ``partial_failure`` with a
      * describing ``detail`` but does not stop the map build — the
      * map-render tool skips absent layers gracefully. */
    workflow BuildGlobalMap(
        openlittermap_zoom: Int = 4,
        include_brownfields: Boolean = true,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        olm = DownloadOpenLitterMap(
            mode = "clusters",
            zoom = $.openlittermap_zoom,
            use_mock = $.use_mock
        ) catch {
            yield BuildGlobalMap(
                status = "partial_failure",
                html_path = "",
                detail = "openlittermap download failed"
            )
        }
        superfund = DownloadEpaCleanups(
            dataset = "superfund",
            use_mock = $.use_mock
        ) catch {
            yield BuildGlobalMap(
                status = "partial_failure",
                html_path = "",
                detail = "epa superfund download failed"
            )
        }
        brownfields = DownloadEpaCleanups(
            dataset = "brownfields",
            use_mock = $.use_mock
        ) catch {
            yield BuildGlobalMap(
                status = "partial_failure",
                html_path = "",
                detail = "epa brownfields download failed"
            )
        }
        // dependency_signal pins the map build after every download
        // by referencing a field each produced — the runtime
        // resolves that as a data-flow edge.
        map = BuildMap(
            region = "global",
            dependency_signal = olm.feature_count + superfund.feature_count + brownfields.feature_count
        ) catch {
            yield BuildGlobalMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildGlobalMap(
            status = "completed",
            html_path = map.html_path,
            detail = "map " ++ map.region_key ++ " with " ++ map.layer_count ++ " layer(s)"
        )
    }

    /** Download OpenLitterMap at a tighter zoom for a specific region
      * (useful for country/state maps where the zoom-4 global feed is
      * too coarse). Chains into the global map build so the new layer
      * is picked up automatically. */
    workflow BuildRegionalMap(
        region_key: String = "us",
        openlittermap_zoom: Int = 8,
        center_lat: Double = 39.8283,
        center_lon: Double = -98.5795,
        zoom: Double = 4.0,
        use_mock: Boolean = false
    ) => (status: String, html_path: String) andThen {
        olm = DownloadOpenLitterMap(
            mode = "clusters",
            zoom = $.openlittermap_zoom,
            use_mock = $.use_mock
        ) catch {
            yield BuildRegionalMap(status = "partial_failure", html_path = "")
        }
        superfund = DownloadEpaCleanups(
            dataset = "superfund",
            use_mock = $.use_mock
        ) catch {
            yield BuildRegionalMap(status = "partial_failure", html_path = "")
        }
        map = BuildMap(
            region = $.region_key,
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            dependency_signal = olm.feature_count + superfund.feature_count
        ) catch {
            yield BuildRegionalMap(status = "failed", html_path = "")
        }
        yield BuildRegionalMap(
            status = "completed",
            html_path = map.html_path
        )
    }

    /** Build an interactive world map of nuclear reactors & plants.
      *
      * Downloads the OSM nuclear dataset, then renders the auto-
      * discovering MapLibre map. The nuclear layer is registered with
      * no curated field list, so clicking any reactor opens a popup
      * showing every attribute the dataset carries. ``dependency_signal``
      * references the download's ``feature_count`` so the runtime
      * sequences the map build strictly after the data is cached. */
    workflow BuildNuclearReactorMap(
        center_lat: Double = 25.0,
        center_lon: Double = 10.0,
        zoom: Double = 2.0,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        reactors = DownloadNuclearReactors(
            use_mock = $.use_mock
        ) catch {
            yield BuildNuclearReactorMap(
                status = "failed",
                html_path = "",
                detail = "nuclear reactor download failed"
            )
        }
        map = BuildMap(
            region = "nuclear",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            dependency_signal = reactors.feature_count,
            only_layers = "nuclear-reactors",
            attribution_workflow = "save_earth.workflows.BuildNuclearReactorMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "Nuclear power reactors and plants worldwide, from OpenStreetMap. Click any site for its full details (operator, electrical output, start date, reactor type, status, ...)."
        ) catch {
            yield BuildNuclearReactorMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildNuclearReactorMap(
            status = "completed",
            html_path = map.html_path,
            detail = "nuclear map with " ++ reactors.feature_count ++ " reactor/plant feature(s)"
        )
    }

    /** Build an interactive world map of heritage-named enclave neighbourhoods.
      *
      * Downloads the OSM enclave dataset (places named Chinatown / Japantown /
      * Little Italy / Koreatown / Little Saigon / Greektown / ...), classified
      * into one GeoJSON per heritage, then renders the MapLibre map with every
      * enclave layer (only_layers="enclave-*") — each heritage its own coloured,
      * toggleable layer with a legend count. No curated field list, so clicking
      * any enclave shows every OSM tag (name first) plus any wikidata link. */
    workflow BuildEnclaveMap(
        center_lat: Double = 42.0,
        center_lon: Double = -35.0,
        zoom: Double = 2.2,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        enclaves = DownloadEthnicEnclaves(
            use_mock = $.use_mock
        ) catch {
            yield BuildEnclaveMap(
                status = "failed",
                html_path = "",
                detail = "enclave download failed"
            )
        }
        map = BuildMap(
            region = "enclaves",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            dependency_signal = enclaves.feature_count,
            only_layers = "enclave-*",
            attribution_workflow = "save_earth.workflows.BuildEnclaveMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "Heritage-named enclave neighbourhoods worldwide, from OpenStreetMap (Chinatown, Japantown, Little Italy, Koreatown, ...). Each heritage is a separate coloured layer - toggle them in the legend. OSM has no ethnicity attribute; the neighbourhood name is the signal. Click any point for all its OSM tags plus any wikidata link."
        ) catch {
            yield BuildEnclaveMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildEnclaveMap(
            status = "completed",
            html_path = map.html_path,
            detail = "enclave map with " ++ enclaves.feature_count ++ " place(s) across " ++ enclaves.heritage_count ++ " heritage(s)"
        )
    }

    /** Build the world power-infrastructure map: power plants by source (WRI:
      * hydro / coal / solar / wind / nuclear) as five coloured, toggleable point
      * layers, plus a ≥500 kV transmission-line layer (OSM). Each layer has no
      * curated field list, so clicking any plant or line shows its full record. */
    workflow BuildPowerMap(
        center_lat: Double = 25.0,
        center_lon: Double = 5.0,
        zoom: Double = 1.6
    ) => (status: String, html_path: String, detail: String) andThen {
        plants = DownloadPowerPlants() catch {
            yield BuildPowerMap(status = "failed", html_path = "", detail = "power plant download failed")
        }
        tiles = ListTransmissionTiles() catch {
            yield BuildPowerMap(status = "failed", html_path = "", detail = "tile list failed")
        }
        scan = ScanTransmissionTiles(tiles = tiles.tiles) catch {
            yield BuildPowerMap(status = "failed", html_path = "", detail = "transmission tile fan-out failed")
        }
        merge = MergeTransmission(tiles = tiles.tiles, dependency_signal = scan.count) catch {
            yield BuildPowerMap(status = "failed", html_path = "", detail = "transmission merge failed")
        }
        map = BuildMap(
            region = "power",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            dependency_signal = plants.feature_count + merge.feature_count,
            only_layers = "power-*",
            attribution_workflow = "save_earth.workflows.BuildPowerMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "World power infrastructure: power plants by source (hydro/dams, coal, solar, wind, nuclear) from the WRI Global Power Plant Database, plus major (>=500 kV) transmission lines from OpenStreetMap (fetched as a per-continent fan-out, merged). Toggle each source in the legend; click any plant or line for its full record. Transmission lines are the highest-voltage backbone only - OSM has no plant-to-substation linkage at world scale."
        ) catch {
            yield BuildPowerMap(status = "failed", html_path = "", detail = "map build failed")
        }
        yield BuildPowerMap(
            status = "completed",
            html_path = map.html_path,
            detail = "power map: " ++ plants.feature_count ++ " plants + " ++ merge.feature_count ++ " transmission lines (fanned out across " ++ scan.count ++ " tiles)"
        )
    }

    /** Build an interactive world map of major (notable) volcanoes.
      *
      * Downloads the OSM volcano dataset (natural=volcano with a Wikipedia/
      * Wikidata entry), then renders the auto-discovering MapLibre map with
      * only the volcano layer. The layer has no curated field list, so
      * clicking any volcano opens a popup showing every OSM attribute it
      * carries (name, ele, volcano:type, volcano:status, …). */
    workflow BuildVolcanoMap(
        center_lat: Double = 20.0,
        center_lon: Double = 10.0,
        zoom: Double = 1.6,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        volcanoes = DownloadVolcanoes(
            use_mock = $.use_mock
        ) catch {
            yield BuildVolcanoMap(
                status = "failed",
                html_path = "",
                detail = "volcano download failed"
            )
        }
        map = BuildMap(
            region = "volcanoes",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            dependency_signal = volcanoes.feature_count,
            only_layers = "volcanoes",
            attribution_workflow = "save_earth.workflows.BuildVolcanoMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "Major (notable) volcanoes worldwide, from OpenStreetMap - natural=volcano features with a Wikipedia/Wikidata entry. Click any volcano for its details (elevation, type, status, ...)."
        ) catch {
            yield BuildVolcanoMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildVolcanoMap(
            status = "completed",
            html_path = map.html_path,
            detail = "volcano map with " ++ volcanoes.feature_count ++ " volcano(es)"
        )
    }

    /** Build an interactive world map of LGBTQ+ bars & restaurants.
      *
      * Downloads the OSM LGBTQ venue dataset, then renders the MapLibre map with
      * only the lgbtq layer. No curated field list, so clicking a venue opens a
      * popup table showing every OSM attribute it carries (name, amenity, lgbtq,
      * opening_hours, website, …). */
    workflow BuildLgbtqVenueMap(
        center_lat: Double = 30.0,
        center_lon: Double = 5.0,
        zoom: Double = 1.7,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        venues = DownloadLgbtqVenues(
            use_mock = $.use_mock
        ) catch {
            yield BuildLgbtqVenueMap(
                status = "failed",
                html_path = "",
                detail = "lgbtq venue download failed"
            )
        }
        map = BuildMap(
            region = "lgbtq",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            dependency_signal = venues.feature_count,
            only_layers = "lgbtq",
            attribution_workflow = "save_earth.workflows.BuildLgbtqVenueMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "LGBTQ+ bars, pubs, clubs and restaurants worldwide, from OpenStreetMap (lgbtq / gay tags). Click any venue for its full details (amenity, opening hours, website, ...)."
        ) catch {
            yield BuildLgbtqVenueMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildLgbtqVenueMap(
            status = "completed",
            html_path = map.html_path,
            detail = "lgbtq map with " ++ venues.feature_count ++ " venue(s)"
        )
    }

    /** Build an interactive world map of Tesla charging stations.
      *
      * Downloads the OSM Tesla charger dataset, then renders the MapLibre map with
      * only the tesla layer. No curated field list, so clicking a charger opens a
      * popup table showing every OSM attribute (operator, capacity, socket:*,
      * opening_hours, fee, ...). */
    workflow BuildTeslaChargerMap(
        center_lat: Double = 30.0,
        center_lon: Double = 5.0,
        zoom: Double = 1.7,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        chargers = DownloadTeslaChargers(
            use_mock = $.use_mock
        ) catch {
            yield BuildTeslaChargerMap(
                status = "failed",
                html_path = "",
                detail = "tesla charger download failed"
            )
        }
        map = BuildMap(
            region = "tesla",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            dependency_signal = chargers.feature_count,
            only_layers = "tesla",
            attribution_workflow = "save_earth.workflows.BuildTeslaChargerMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "Tesla charging stations worldwide (Superchargers + destination chargers), from OpenStreetMap. Click any charger for its full details (operator, capacity, socket types, opening hours, ...)."
        ) catch {
            yield BuildTeslaChargerMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildTeslaChargerMap(
            status = "completed",
            html_path = map.html_path,
            detail = "tesla map with " ++ chargers.feature_count ++ " charger(s)"
        )
    }

    /** Build an interactive world map of named research telescopes.
      *
      * Downloads the OSM telescope dataset, then renders the MapLibre map with
      * only the telescopes layer. No curated field list, so clicking a telescope
      * opens a popup table showing every OSM attribute (telescope:type,
      * telescope:diameter, operator, start_date, wikipedia, ...). */
    workflow BuildTelescopeMap(
        center_lat: Double = 25.0,
        center_lon: Double = 0.0,
        zoom: Double = 1.6,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        scopes = DownloadTelescopes(
            use_mock = $.use_mock
        ) catch {
            yield BuildTelescopeMap(
                status = "failed",
                html_path = "",
                detail = "telescope download failed"
            )
        }
        map = BuildMap(
            region = "telescopes",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            dependency_signal = scopes.feature_count,
            only_layers = "telescopes",
            attribution_workflow = "save_earth.workflows.BuildTelescopeMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "Named research telescopes worldwide (optical + radio), from OpenStreetMap. Click any telescope for its full details (type, diameter, operator, ...)."
        ) catch {
            yield BuildTelescopeMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildTelescopeMap(
            status = "completed",
            html_path = map.html_path,
            detail = "telescope map with " ++ scopes.feature_count ++ " telescope(s)"
        )
    }

    /** Seismic-hazard world map: recent earthquakes over the fault lines.
      *
      * Downloads recent significant earthquakes (USGS M4.5+, past 30 days) and
      * the tectonic plate boundaries (Bird 2002), then renders both on one map:
      * quakes as circles sized and coloured by magnitude, faults as lines.
      * BuildMap depends on both downloads via the summed feature counts. */
    workflow BuildSeismicMap(
        center_lat: Double = 20.0,
        center_lon: Double = 0.0,
        zoom: Double = 1.5,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        faults = DownloadFaults(
            use_mock = $.use_mock
        ) catch {
            yield BuildSeismicMap(
                status = "failed",
                html_path = "",
                detail = "fault-line download failed"
            )
        }
        quakes = DownloadEarthquakes(
            use_mock = $.use_mock
        ) catch {
            yield BuildSeismicMap(
                status = "failed",
                html_path = "",
                detail = "earthquake download failed"
            )
        }
        map = BuildMap(
            region = "seismic",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            dependency_signal = faults.feature_count + quakes.feature_count,
            only_layers = "faults,earthquakes",
            attribution_workflow = "save_earth.workflows.BuildSeismicMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "Recent earthquakes (USGS M4.5+, past 30 days), sized and coloured by magnitude, over the tectonic plate boundaries (the major global fault lines, Bird 2002). Quakes cluster along the boundaries. Click any quake or fault for its full details."
        ) catch {
            yield BuildSeismicMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildSeismicMap(
            status = "completed",
            html_path = map.html_path,
            detail = "seismic map with " ++ quakes.feature_count ++ " quake(s)"
        )
    }
}
