// save-earth — FFL definitions for the environmental-action map pipeline.
//
// Mirrors the CLI surface in ``save_earth/tools/`` — each
// event facet wraps one _save_earth_tools function, handlers are thin
// dispatchers that import from _save_earth_tools/ via a sys.path shim.
// The runtime and the
// terminal produce identical outputs and share the cache rooted at
// ``$FW_CACHE_ROOT/save-earth/``.
//
// Data sources covered in this pass:
//   - OpenLitterMap (crowd-sourced geotagged litter observations)
//   - EPA Superfund NPL + Brownfields (authoritative remediation sites)
// Later PRs can add Tree Equity Score, Open311 cleanup feeds, and
// Surfrider chapters by defining new event facets in save_earth.sources
// without touching the map-build facet.

// ---------------------------------------------------------------------------
// Schemas
// ---------------------------------------------------------------------------

namespace save_earth.types {
    /** Result of any source download — one cached GeoJSON + sidecar.
      *
      * Matches the ``FetchResult`` dataclass the _save_earth_tools modules return so
      * FFL workflows can key downstream steps on ``relative_path`` or
      * ``feature_count`` without parsing the cached file. */
    schema SourceFetchResult {
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    }

    /** Output of BuildMap: filesystem paths to the rendered bundle.
      *
      * ``layer_counts`` is ``{layer_name: feature_count}`` as a JSON
      * object so the schema stays flat even when new sources get
      * added later. */
    schema MapBundle {
        region_key: String,
        output_dir: String,
        html_path: String,
        layer_count: Int,
        layer_counts: Json
    }
}

// ---------------------------------------------------------------------------
// Shared mixins
// ---------------------------------------------------------------------------

namespace save_earth.mixins {
    /** Retry a step with exponential backoff. Applied to every
      * network-facing source download — OpenLitterMap's servers can
      * rate-limit, EPA's ArcGIS fronts occasionally 5xx. */
    facet RetryPolicy(
        max_retries: Int = 3,
        backoff_ms: Int = 2000
    ) => (max_retries: Int, backoff_ms: Int)

    implicit default_retry = RetryPolicy()
}

// ---------------------------------------------------------------------------
// Sources — one event facet per cached data source.
// ---------------------------------------------------------------------------

namespace save_earth.sources {
    use save_earth.types

    /** Download OpenLitterMap geotagged litter observations.
      *
      * ``mode = "clusters"`` (default) works at any zoom; returns
      * aggregated cluster points. ``mode = "points"`` returns
      * individual photos but the upstream server enforces
      * ``zoom >= 15`` and a bounded ``bbox``.
      *
      * ``bbox`` is a comma-separated ``min_lon,min_lat,max_lon,max_lat``
      * string (empty = no bbox). Keeping it a String avoids making
      * Json mandatory; handlers parse it at dispatch time. */
    event facet DownloadOpenLitterMap(
        mode: String = "clusters",
        zoom: Int = 4,
        bbox: String = "",
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download the EPA Toxic Release Inventory facility table.
      *
      * Fetches TRI_FACILITY from ``data.epa.gov/efservice/`` (the
      * old ``enviro.epa.gov`` URL redirects there). ~65 k rows
      * total, paginated at 10 k/request. Normalizes longitude sign
      * for western-hemisphere state codes.
      *
      * ``active_only`` (default true) drops facilities whose
      * ``fac_closed_ind`` is ``"1"``. */
    event facet DownloadTri(
        active_only: Boolean = true,
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download an EPA remediation-site dataset.
      *
      * ``dataset`` = ``"superfund"`` (NPL sites, ~1.4k) or
      * ``"brownfields"`` (ACRES, tens of thousands — paginated
      * transparently by the handler). */
    event facet DownloadEpaCleanups(
        dataset: String = "superfund",
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download worldwide nuclear power reactors & plants from OSM.
      *
      * Queries the OpenStreetMap Overpass API for every feature tagged
      * ``generator:source=nuclear`` (an individual reactor) or
      * ``plant:source=nuclear`` (a whole station), centroiding any
      * way/relation polygon to a Point. Every OSM tag is kept verbatim
      * as the feature's properties, so the map popup can surface all
      * available information (name, operator, output:electricity,
      * start_date, reactor method, status, …). Coverage and tag
      * completeness are OSM-community-driven and vary by country. */
    event facet DownloadNuclearReactors(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download worldwide ALPR surveillance camera locations from OSM (DeFlock).
      *
      * Queries the OpenStreetMap Overpass API for every node tagged
      * ``man_made=surveillance`` + ``surveillance:type=ALPR`` — the
      * crowd-sourced Automatic License Plate Reader inventory the DeFlock
      * project maintains in OSM. This is camera LOCATIONS only (no video
      * or plate-read data — that is private to the operators). Every OSM
      * tag is kept verbatim as the feature's properties (manufacturer,
      * operator, direction the camera faces, surveillance:zone, mount, ...)
      * plus a derived ``camera_vendor`` (flock/motorola/other), so the map
      * popup can surface all available information. ~336k nodes worldwide;
      * coverage is crowd-driven and varies by region. */
    event facet DownloadALPRCameras(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download US data-center locations from OSM (telecom/man_made=data_center,
      * continental-US bbox, footprints centroided). Every OSM tag kept verbatim.
      * Coverage is OSM-community-driven and incomplete; there is no open registry
      * of *proposed* data centers, so this is existing/mapped facilities only. */
    event facet DownloadDataCenters(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download nuclear test sites (military=nuclear_explosion_site) + missile
      * silos (bunker_type=missile_silo) worldwide from OSM. Publicly-tagged,
      * geographically-fixed features; every OSM tag kept verbatim + a derived
      * ``site_type`` so the two split into separate toggleable map layers.
      * Coverage is community-driven and incomplete (esp. silos). */
    event facet DownloadNuclearSites(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download US principal-aquifer polygons from the USGS ArcGIS FeatureServer
      * (server-side simplified; rock-only regions excluded). The groundwater
      * backdrop the data-center map overlays. */
    event facet DownloadAquifers(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download worldwide heritage-named enclave neighbourhoods from OSM.
      *
      * Queries the Overpass API for named places (place=neighbourhood /
      * quarter / suburb / city_block / locality) whose NAME marks a heritage
      * enclave — Chinatown, Japantown, Little Italy, Koreatown, Little Saigon,
      * Greektown, Little Havana, … OSM has no structured ethnicity attribute
      * (demographics aren't on-the-ground verifiable), so the name is the
      * signal; each match is classified into a heritage bucket and written to
      * one GeoJSON per heritage (chinese.geojson, italian.geojson, …) so the
      * map renders one coloured, toggleable layer per heritage. Every OSM tag
      * is kept verbatim for the popup; many carry a wikidata/wikipedia link.
      * Coverage is community-driven and uneven (rich in US/European metros). */
    event facet DownloadEthnicEnclaves(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        feature_count: Int,
        heritage_count: Int,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download world power plants by source from the WRI Global Power Plant
      * Database — hydro (dams) / coal / solar / wind / nuclear, ~35k plants,
      * one GeoJSON per source. Every WRI field (name, capacity_mw, fuel,
      * commissioning year, country, owner) is kept for the popup. */
    event facet DownloadPowerPlants(
        force: Boolean = false
    ) => (
        cache_type: String,
        feature_count: Int,
        layer_count: Int,
        source_url: String
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Annotate the cached solar & wind power plants with the local renewable
      * RESOURCE at each site - answering "is this plant actually where the sun /
      * wind is good?". Reads the WRI solar/wind layers, samples each plant's
      * location against NASA POWER's 20-year climatology (GHI for solar, 50 m
      * wind speed for wind), de-duplicated onto a coarse grid so it is a few
      * hundred SEQUENTIAL point calls, NOT a fan-out (shared egress IP), and
      * writes one annotated GeoJSON per source. Each plant carries its raw
      * resource value plus a ``siting_score`` (4..8) that the renderer maps onto
      * its yellow->red ramp: dark-red/large = excellent resource (well sited),
      * yellow/small = poor. Order it with `after <DownloadPowerPlants step>` —
      * it reads what that step cached, so no value flows between them. */
    event facet AnnotateRenewableSiting(
        force: Boolean = false
    ) => (
        cache_type: String,
        feature_count: Int,
        cells_sampled: Int,
        was_cached: Boolean,
        source_url: String
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "expensive") with Timeout(minutes = 30)

    /** Download world ≥500 kV transmission lines from OpenStreetMap — BOUNDED +
      * cache-aware. Fetches the tiles one at a time (Overpass rate-limits ~2 per
      * IP and the fleet shares one egress, so a wide fan-out just thrashes) and
      * ONLY when not already cached. ``force=true`` re-fetches. This is the form
      * BuildPowerMap uses; the ScanTransmissionTiles fan-out below is a kept
      * demonstration of when *not* to fan out. */
    event facet DownloadTransmission(
        force: Boolean = false
    ) => (
        cache_type: String,
        feature_count: Int,
        was_cached: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "expensive") with Timeout(minutes = 30)

    /** Emit the list of tiles ("S,W,N,E" bbox strings) the ≥500 kV transmission
      * fan-out spreads over (dense continents split so no single query 504s). */
    event facet ListTransmissionTiles() => (
        tiles: Json,
        count: Int
    ) with Effect(kind = "pure") with Cost(tier = "free")

    /** Fetch ≥500 kV transmission lines for ONE bounding box ("S,W,N,E") from
      * OSM, cached as a per-tile GeoJSON. A single global query 504s, so the
      * world is tiled and these tiles run in PARALLEL (ScanTransmissionTiles). */
    event facet DownloadTransmissionTile(
        bbox: String,
        force: Boolean = false
    ) => (
        bbox: String,
        feature_count: Int
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate") with Timeout(minutes = 15)

    /** Fan out the ≥500 kV transmission fetch across the tiles — one
      * DownloadTransmissionTile per tile, in parallel across the fleet, so a
      * region that times out retries on its own without sinking the whole fetch.
      * (A `workflow` with a foreach body — not an `event facet` — so the runtime
      * runs the fan-out rather than waiting for a handler.) */
    workflow ScanTransmissionTiles(
        tiles: Json
    ) => (
        count: Int
    ) andThen foreach tile in $.tiles {
        t = DownloadTransmissionTile(bbox = $.tile)
        yield ScanTransmissionTiles(count = 1)
    }

    /** Merge the per-tile transmission GeoJSONs into one ≥500 kV layer, deduping
      * lines that cross a tile border by OSM way id. Order it with
      * ``after <scan step>``; on a fan-out step that waits for every tile. */
    event facet MergeTransmission(
        tiles: Json
    ) => (
        cache_type: String,
        feature_count: Int
    ) with Effect(kind = "io") with Cost(tier = "cheap")

    /** Download worldwide major (notable) volcanoes from OSM.
      *
      * Queries the OpenStreetMap Overpass API for every feature tagged
      * ``natural=volcano`` that also carries a ``wikidata`` or ``wikipedia``
      * tag — encyclopedic notability as the "major" proxy (OSM has no reliable
      * global prominence/VEI tag), yielding ~1-2k worldwide. Every OSM tag is
      * kept verbatim as the feature's properties so the map popup can surface
      * all available information (name, ele, volcano:type, volcano:status, …).
      * Coverage and tag completeness are OSM-community-driven. */
    event facet DownloadVolcanoes(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download worldwide LGBTQ+ bars & restaurants from OSM.
      *
      * Queries the OpenStreetMap Overpass API for food/drink venues (bar, pub,
      * nightclub, restaurant, cafe, fast_food, biergarten) tagged LGBTQ-oriented
      * or LGBTQ-welcoming (``lgbtq=*`` other than ``no``, or the older
      * ``gay=yes``). Every OSM tag is kept verbatim so the popup table shows all
      * available info (name, amenity, lgbtq, opening_hours, website, …). */
    event facet DownloadLgbtqVenues(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download worldwide named research telescopes from OpenStreetMap.
      *
      * Queries Overpass for named man_made=telescope (optical + radio). Every OSM
      * tag is kept verbatim; feature_kind = the telescope:type (else "telescope"). */
    event facet DownloadTelescopes(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download worldwide Tesla charging stations from OpenStreetMap.
      *
      * Queries Overpass for amenity=charging_station branded / networked /
      * operated as Tesla (or carrying a Tesla supercharger socket). Every OSM tag
      * is kept verbatim; feature_kind = supercharger | charger. */
    event facet DownloadTeslaChargers(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download recent significant earthquakes worldwide from the USGS feed.
      *
      * The default feed is magnitude 4.5+ over the past 30 days (a clean global
      * signal). Each feature is a Point with the USGS properties verbatim
      * (mag, place, time, magType, tsunami, …) plus a derived depth_km. */
    event facet DownloadEarthquakes(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download tectonic plate boundaries (the major global fault lines).
      *
      * Peter Bird (2002) PB2002 boundaries as LineString features. Plate
      * boundaries are effectively static, so this caches for a long time. */
    event facet DownloadFaults(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Download NASA FIRMS active-fire / thermal-anomaly detections (past 24h).
      *
      * Merges the two keyless global feeds -- VIIRS S-NPP (375 m) and MODIS
      * Terra/Aqua (1 km) -- into one GeoJSON, normalising each sensor's own
      * confidence onto a shared low/nominal/high band and sorting by fire
      * radiative power descending.
      *
      * These are THERMAL ANOMALIES, not confirmed wildfires: gas flares,
      * industrial heat, active lava and agricultural burning all register the
      * same way, and the feed does not distinguish them. Detections are also
      * limited by cloud cover and satellite overpass, so an empty area means
      * "nothing detected", never "nothing burning".
      *
      * Near-real-time data, so the cache holds for ~1 hour rather than days. */
    event facet DownloadActiveFire(
        force: Boolean = false,
        use_mock: Boolean = false
    ) => (
        cache_type: String,
        relative_path: String,
        feature_count: Int,
        size_bytes: Int,
        sha256: String,
        source_url: String,
        was_cached: Boolean,
        used_mock: Boolean,
        high_count: Int,
        nominal_count: Int,
        low_count: Int,
        acquired_from: String,
        acquired_to: String
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate") with Timeout(minutes = 15)

    /** Enumerate admin-0 countries (Natural Earth) for the per-country fab
      * fan-out. Returns a JSON list of {iso2, name} (not a hardcoded list). */
    event facet ListFabCountries() => (
        countries: Json,
        country_count: Int
    ) with Effect(kind = "external") with Cost(tier = "cheap")

    /** Fetch ONE country's semiconductor fabrication plants from the OSM
      * Overpass API (industrial=semiconductor / industry=semiconductor /
      * man_made=works + product matching semiconductor terms), keeping every OSM
      * tag for the map popup. Cache-first: a present per-country cache is ALWAYS
      * reused; only force=true re-queries Overpass. */
    event facet DownloadFabsForCountry(
        country_iso2: String,
        country_name: String = "",
        force: Boolean = false
    ) => (
        relative_path: String,
        feature_count: Int,
        was_cached: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")

    /** Merge the per-country fab GeoJSON parts into the single rendered world
      * layer (de-duped by osm_type + osm_id). */
    event facet MergeFabs(
        parts: [String],
        wikidata_path: String = ""
    ) => (
        relative_path: String,
        feature_count: Int,
        country_count: Int
    ) with Effect(kind = "pure") with Cost(tier = "cheap")

    /** Fetch every geocoded semiconductor fab from Wikidata in ONE SPARQL query
      * (no fan-out: Wikidata has no per-area query limit). Structured fields OSM
      * lacks (operator, country, inception, owner, wikipedia) for richer popups.
      * Sparse + historical on its own, so it is UNIONed with the OSM source.
      * Cache-first; only force=true re-queries. */
    event facet DownloadFabsWikidata(
        force: Boolean = false
    ) => (
        relative_path: String,
        feature_count: Int,
        was_cached: Boolean
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "moderate")
}

// ---------------------------------------------------------------------------
// Maps — stitch cached GeoJSON into a MapLibre HTML bundle.
// ---------------------------------------------------------------------------

namespace save_earth.maps {
    use save_earth.types

    /** Build a MapLibre HTML map with every cached save-earth layer.
      *
      * Auto-discovers cached files — every OpenLitterMap GeoJSON under
      * ``cache/save-earth/openlittermap/`` and every EPA dataset
      * becomes its own toggleable layer. Passing a dependency signal
      * (e.g. the ``feature_count`` from a just-finished download) lets
      * the runtime sequence the map build after the downloads it
      * relies on.
      *
      * ``basemap_url`` / ``basemap_attribution`` let the caller swap
      * the raster basemap. Default is CARTO Voyager — free, no API
      * key, works from ``file://`` (unlike tile.openstreetmap.org,
      * which requires a Referer header per its volunteer-tile
      * policy). Supports ``{z}/{x}/{y}`` plus optional ``{s}`` for
      * subdomain rotation. */
    event facet BuildMap(
        region: String = "global",
        center_lat: Double = 39.8283,
        center_lon: Double = -98.5795,
        zoom: Double = 4.0,
        basemap_url: String = "",
        basemap_attribution: String = "",
        only_layers: String = "",
        attribution_workflow: String = "",
        attribution_ffl_url: String = "",
        description: String = "",
        max_inline_features: Int = 0
    ) => (
        region_key: String,
        output_dir: String,
        html_path: String,
        layer_count: Int,
        layer_counts: Json
    ) with Effect(kind = "io") with Cost(tier = "cheap")
}

// ---------------------------------------------------------------------------
// Workflows
// ---------------------------------------------------------------------------

namespace save_earth.workflows {
    use save_earth.types

    /** Download every source and build the combined global map.
      *
      * Downloads run in parallel (FFL ``andThen`` siblings are
      * scheduled concurrently when they don't reference each other).
      * Any download failure yields ``partial_failure`` with a
      * describing ``detail`` but does not stop the map build — the
      * map-render tool skips absent layers gracefully. */
    workflow BuildGlobalMap(
        openlittermap_zoom: Int = 4,
        include_brownfields: Boolean = true,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        olm = DownloadOpenLitterMap(
            mode = "clusters",
            zoom = $.openlittermap_zoom,
            use_mock = $.use_mock
        ) catch {
            yield BuildGlobalMap(
                status = "partial_failure",
                html_path = "",
                detail = "openlittermap download failed"
            )
        }
        superfund = DownloadEpaCleanups(
            dataset = "superfund",
            use_mock = $.use_mock
        ) catch {
            yield BuildGlobalMap(
                status = "partial_failure",
                html_path = "",
                detail = "epa superfund download failed"
            )
        }
        brownfields = DownloadEpaCleanups(
            dataset = "brownfields",
            use_mock = $.use_mock
        ) catch {
            yield BuildGlobalMap(
                status = "partial_failure",
                html_path = "",
                detail = "epa brownfields download failed"
            )
        }
        // `after` pins the map build behind every download: they share only
        // the cache, so there is no data edge for the runtime to infer.
        map = BuildMap(
            region = "global"
        ) after olm, superfund, brownfields catch {
            yield BuildGlobalMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildGlobalMap(
            status = "completed",
            html_path = map.html_path,
            detail = "map " ++ map.region_key ++ " with " ++ map.layer_count ++ " layer(s)"
        )
    }

    /** Download OpenLitterMap at a tighter zoom for a specific region
      * (useful for country/state maps where the zoom-4 global feed is
      * too coarse). Chains into the global map build so the new layer
      * is picked up automatically. */
    workflow BuildRegionalMap(
        region_key: String = "us",
        openlittermap_zoom: Int = 8,
        center_lat: Double = 39.8283,
        center_lon: Double = -98.5795,
        zoom: Double = 4.0,
        use_mock: Boolean = false
    ) => (status: String, html_path: String) andThen {
        olm = DownloadOpenLitterMap(
            mode = "clusters",
            zoom = $.openlittermap_zoom,
            use_mock = $.use_mock
        ) catch {
            yield BuildRegionalMap(status = "partial_failure", html_path = "")
        }
        superfund = DownloadEpaCleanups(
            dataset = "superfund",
            use_mock = $.use_mock
        ) catch {
            yield BuildRegionalMap(status = "partial_failure", html_path = "")
        }
        map = BuildMap(
            region = $.region_key,
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom
        ) after olm, superfund catch {
            yield BuildRegionalMap(status = "failed", html_path = "")
        }
        yield BuildRegionalMap(
            status = "completed",
            html_path = map.html_path
        )
    }

    /** Build an interactive world map of nuclear reactors & plants.
      *
      * Downloads the OSM nuclear dataset, then renders the auto-
      * discovering MapLibre map. The nuclear layer is registered with
      * no curated field list, so clicking any reactor opens a popup
      * showing every attribute the dataset carries. The map build is ordered
      * with ``after`` behind the download, since it reads only the cache. */
    workflow BuildNuclearReactorMap(
        center_lat: Double = 25.0,
        center_lon: Double = 10.0,
        zoom: Double = 2.0,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        reactors = DownloadNuclearReactors(
            use_mock = $.use_mock
        ) catch {
            yield BuildNuclearReactorMap(
                status = "failed",
                html_path = "",
                detail = "nuclear reactor download failed"
            )
        }
        map = BuildMap(
            region = "nuclear",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            only_layers = "nuclear-reactors",
            attribution_workflow = "save_earth.workflows.BuildNuclearReactorMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "Nuclear power reactors and plants worldwide, from OpenStreetMap. Click any site for its full details (operator, electrical output, start date, reactor type, status, ...)."
        ) after reactors catch {
            yield BuildNuclearReactorMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildNuclearReactorMap(
            status = "completed",
            html_path = map.html_path,
            detail = "nuclear map with " ++ reactors.feature_count ++ " reactor/plant feature(s)"
        )
    }

    /** Build an interactive world map of ALPR surveillance cameras (DeFlock).
      *
      * Downloads the OSM ALPR dataset (crowd-sourced camera locations),
      * then renders the auto-discovering MapLibre map. The alpr-cameras
      * layer is registered with no curated field list, so clicking any
      * camera opens a popup showing every attribute the dataset carries
      * (manufacturer, operator, direction, surveillance:zone, ...).
      * The map build is ordered with ``after`` behind the download, since it
      * reads only the cache. Camera LOCATIONS only — no video/plate data. */
    workflow BuildALPRCameraMap(
        center_lat: Double = 39.8283,
        center_lon: Double = -98.5795,
        zoom: Double = 4.0,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        cameras = DownloadALPRCameras(
            use_mock = $.use_mock
        ) catch {
            yield BuildALPRCameraMap(
                status = "failed",
                html_path = "",
                detail = "ALPR camera download failed"
            )
        }
        map = BuildMap(
            region = "alpr",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            only_layers = "alpr-*",
            max_inline_features = 130000,
            attribution_workflow = "save_earth.workflows.BuildALPRCameraMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "ALPR (Automatic License Plate Reader) surveillance camera locations worldwide, crowd-sourced in OpenStreetMap by the DeFlock project. Split by vendor (Flock Safety / Motorola / other) with a coverage-density heatmap. Camera LOCATIONS only, not video or plate data. Click any camera for its full details (manufacturer, operator, direction, mounting, ...)."
        ) after cameras catch {
            yield BuildALPRCameraMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildALPRCameraMap(
            status = "completed",
            html_path = map.html_path,
            detail = "ALPR camera map with " ++ cameras.feature_count ++ " camera(s)"
        )
    }

    /** Build a world map of nuclear test sites + missile silos (OSM), each a
      * separate toggleable layer (checkbox) so you can view either or both.
      * Publicly-tagged, fixed locations; coverage is incomplete. */
    workflow BuildNuclearSitesMap(
        center_lat: Double = 30.0,
        center_lon: Double = 10.0,
        zoom: Double = 2.0,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        sites = DownloadNuclearSites(
            use_mock = $.use_mock
        ) catch {
            yield BuildNuclearSitesMap(status = "failed", html_path = "",
                detail = "nuclear-sites download failed")
        }
        map = BuildMap(
            region = "nuclear-sites",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            only_layers = "nuclear-test-sites,missile-silos",
            attribution_workflow = "save_earth.workflows.BuildNuclearSitesMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "Nuclear test sites and missile silos worldwide, from OpenStreetMap. Toggle each layer with the checkboxes in the Layers panel. These are publicly-tagged, geographically-fixed features (the same locations arms-control groups publish for transparency); OSM coverage is community-driven and incomplete, especially for silos. Click any site for its full details."
        ) after sites catch {
            yield BuildNuclearSitesMap(status = "failed", html_path = "",
                detail = "map build failed")
        }
        yield BuildNuclearSitesMap(
            status = "completed",
            html_path = map.html_path,
            detail = "nuclear-sites map: " ++ sites.feature_count ++ " test sites + silos"
        )
    }

    /** Build a US map of data centers overlaid on principal-aquifer polygons —
      * where high-water-use compute sits over major groundwater. Downloads both
      * layers, then renders the aquifer fill under the data-center points. */
    workflow BuildDataCenterWaterMap(
        center_lat: Double = 39.5,
        center_lon: Double = -98.0,
        zoom: Double = 4.0,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        aq = DownloadAquifers(
            use_mock = $.use_mock
        ) catch {
            yield BuildDataCenterWaterMap(status = "failed", html_path = "",
                detail = "aquifer download failed")
        }
        dc = DownloadDataCenters(
            use_mock = $.use_mock
        ) catch {
            yield BuildDataCenterWaterMap(status = "failed", html_path = "",
                detail = "data-center download failed")
        }
        map = BuildMap(
            region = "data-centers",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            only_layers = "aquifers,data-centers",
            attribution_workflow = "save_earth.workflows.BuildDataCenterWaterMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "US data centers (OpenStreetMap) overlaid on principal-aquifer polygons (USGS). Data centers use large volumes of water for cooling, so siting them over stressed groundwater is a growing concern. OSM data-center coverage is incomplete, and no open dataset of PROPOSED data centers exists (they are tracked via news and zoning filings) - so this shows existing, mapped facilities only. Click a data center for its full details, or an aquifer for its name."
        ) after dc, aq catch {
            yield BuildDataCenterWaterMap(status = "failed", html_path = "",
                detail = "map build failed")
        }
        yield BuildDataCenterWaterMap(
            status = "completed",
            html_path = map.html_path,
            detail = "data-center + aquifer map: " ++ dc.feature_count ++ " data centers over " ++ aq.feature_count ++ " aquifer polygons"
        )
    }

    /** Build an interactive world map of heritage-named enclave neighbourhoods.
      *
      * Downloads the OSM enclave dataset (places named Chinatown / Japantown /
      * Little Italy / Koreatown / Little Saigon / Greektown / ...), classified
      * into one GeoJSON per heritage, then renders the MapLibre map with every
      * enclave layer (only_layers="enclave-*") — each heritage its own coloured,
      * toggleable layer with a legend count. No curated field list, so clicking
      * any enclave shows every OSM tag (name first) plus any wikidata link. */
    workflow BuildEnclaveMap(
        center_lat: Double = 42.0,
        center_lon: Double = -35.0,
        zoom: Double = 2.2,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        enclaves = DownloadEthnicEnclaves(
            use_mock = $.use_mock
        ) catch {
            yield BuildEnclaveMap(
                status = "failed",
                html_path = "",
                detail = "enclave download failed"
            )
        }
        map = BuildMap(
            region = "enclaves",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            only_layers = "enclave-*",
            attribution_workflow = "save_earth.workflows.BuildEnclaveMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "Heritage-named enclave neighbourhoods worldwide, from OpenStreetMap (Chinatown, Japantown, Little Italy, Koreatown, ...). Each heritage is a separate coloured layer - toggle them in the legend. OSM has no ethnicity attribute; the neighbourhood name is the signal. Click any point for all its OSM tags plus any wikidata link."
        ) after enclaves catch {
            yield BuildEnclaveMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildEnclaveMap(
            status = "completed",
            html_path = map.html_path,
            detail = "enclave map with " ++ enclaves.feature_count ++ " place(s) across " ++ enclaves.heritage_count ++ " heritage(s)"
        )
    }

    /** Build the world power-infrastructure map: power plants by source (WRI:
      * hydro / coal / solar / wind / nuclear) as five coloured, toggleable point
      * layers, plus a ≥500 kV transmission-line layer (OSM). Each layer has no
      * curated field list, so clicking any plant or line shows its full record. */
    workflow BuildPowerMap(
        force: Boolean = false,
        center_lat: Double = 25.0,
        center_lon: Double = 5.0,
        zoom: Double = 1.6
    ) => (status: String, html_path: String, detail: String) andThen {
        plants = DownloadPowerPlants(force = $.force) catch {
            yield BuildPowerMap(status = "failed", html_path = "", detail = "power plant download failed")
        }
        lines = DownloadTransmission(force = $.force) catch {
            yield BuildPowerMap(status = "failed", html_path = "", detail = "transmission download failed")
        }
        map = BuildMap(
            region = "power",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            only_layers = "power-*",
            attribution_workflow = "save_earth.workflows.BuildPowerMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "World power infrastructure: power plants by source (hydro/dams, coal, natural gas, solar, wind, nuclear) from the WRI Global Power Plant Database, plus the major transmission backbone from OpenStreetMap. NOTE: only the highest-voltage (>=500 kV) lines are shown, so a line often looks like it just 'ends' in mid-air - that is where it steps down to the lower-voltage (400/230 kV) lines that are not shown but carry the power the rest of the way to substations and cities. (OSM also has no plant-to-substation linkage at world scale.) Toggle each source in the legend; click any plant or line for its full record. Cached: re-runs reuse the cache unless force=true."
        ) after plants, lines catch {
            yield BuildPowerMap(status = "failed", html_path = "", detail = "map build failed")
        }
        yield BuildPowerMap(
            status = "completed",
            html_path = map.html_path,
            detail = "power map: " ++ plants.feature_count ++ " plants + " ++ lines.feature_count ++ " transmission lines (cache " ++ lines.was_cached ++ ")"
        )
    }

    /** Build the renewable-energy SITING map: solar & wind power plants coloured
      * by how good the sun / wind resource actually is where each one sits (NASA
      * POWER 20-year climatology). Larger, darker-red points sit on a better
      * resource (well sited); smaller, yellow points sit on a poorer one. Two
      * toggleable layers (solar, wind); click any plant for its full WRI record
      * plus the sampled resource value. */
    workflow BuildRenewableSitingMap(
        force: Boolean = false,
        center_lat: Double = 25.0,
        center_lon: Double = 5.0,
        zoom: Double = 1.6
    ) => (status: String, html_path: String, detail: String) andThen {
        plants = DownloadPowerPlants(force = $.force) catch {
            yield BuildRenewableSitingMap(status = "failed", html_path = "", detail = "power plant download failed")
        }
        sited = AnnotateRenewableSiting(
            force = $.force
        ) after plants catch {
            yield BuildRenewableSitingMap(status = "failed", html_path = "", detail = "resource annotation failed")
        }
        map = BuildMap(
            region = "siting",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            only_layers = "siting-*",
            attribution_workflow = "save_earth.workflows.BuildRenewableSitingMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "Renewable-energy siting: solar and wind power plants (WRI Global Power Plant Database) coloured by the local RESOURCE - how good the sun/wind actually is where each plant sits, from NASA POWER's 20-year climatology (solar GHI / 50 m wind speed). Larger, darker-red points sit on a better resource (well sited); smaller, yellow points sit on a poorer one. Toggle the solar/wind layers in the legend; click any plant for its full WRI record plus the sampled resource value. Cached: re-runs reuse the cache unless force=true."
        ) after sited catch {
            yield BuildRenewableSitingMap(status = "failed", html_path = "", detail = "map build failed")
        }
        yield BuildRenewableSitingMap(
            status = "completed",
            html_path = map.html_path,
            detail = "siting map: " ++ sited.feature_count ++ " solar+wind plants, " ++ sited.cells_sampled ++ " resource cells sampled"
        )
    }

    /** Build an interactive world map of major (notable) volcanoes.
      *
      * Downloads the OSM volcano dataset (natural=volcano with a Wikipedia/
      * Wikidata entry), then renders the auto-discovering MapLibre map with
      * only the volcano layer. The layer has no curated field list, so
      * clicking any volcano opens a popup showing every OSM attribute it
      * carries (name, ele, volcano:type, volcano:status, …). */
    workflow BuildVolcanoMap(
        center_lat: Double = 20.0,
        center_lon: Double = 10.0,
        zoom: Double = 1.6,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        volcanoes = DownloadVolcanoes(
            use_mock = $.use_mock
        ) catch {
            yield BuildVolcanoMap(
                status = "failed",
                html_path = "",
                detail = "volcano download failed"
            )
        }
        map = BuildMap(
            region = "volcanoes",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            only_layers = "volcanoes",
            attribution_workflow = "save_earth.workflows.BuildVolcanoMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "Major (notable) volcanoes worldwide, from OpenStreetMap - natural=volcano features with a Wikipedia/Wikidata entry. Click any volcano for its details (elevation, type, status, ...)."
        ) after volcanoes catch {
            yield BuildVolcanoMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildVolcanoMap(
            status = "completed",
            html_path = map.html_path,
            detail = "volcano map with " ++ volcanoes.feature_count ++ " volcano(es)"
        )
    }

    /** Build an interactive world map of LGBTQ+ bars & restaurants.
      *
      * Downloads the OSM LGBTQ venue dataset, then renders the MapLibre map with
      * only the lgbtq layer. No curated field list, so clicking a venue opens a
      * popup table showing every OSM attribute it carries (name, amenity, lgbtq,
      * opening_hours, website, …). */
    workflow BuildLgbtqVenueMap(
        center_lat: Double = 30.0,
        center_lon: Double = 5.0,
        zoom: Double = 1.7,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        venues = DownloadLgbtqVenues(
            use_mock = $.use_mock
        ) catch {
            yield BuildLgbtqVenueMap(
                status = "failed",
                html_path = "",
                detail = "lgbtq venue download failed"
            )
        }
        map = BuildMap(
            region = "lgbtq",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            only_layers = "lgbtq",
            attribution_workflow = "save_earth.workflows.BuildLgbtqVenueMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "LGBTQ+ bars, pubs, clubs and restaurants worldwide, from OpenStreetMap (lgbtq / gay tags). Click any venue for its full details (amenity, opening hours, website, ...)."
        ) after venues catch {
            yield BuildLgbtqVenueMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildLgbtqVenueMap(
            status = "completed",
            html_path = map.html_path,
            detail = "lgbtq map with " ++ venues.feature_count ++ " venue(s)"
        )
    }

    /** Build an interactive world map of Tesla charging stations.
      *
      * Downloads the OSM Tesla charger dataset, then renders the MapLibre map with
      * only the tesla layer. No curated field list, so clicking a charger opens a
      * popup table showing every OSM attribute (operator, capacity, socket:*,
      * opening_hours, fee, ...). */
    workflow BuildTeslaChargerMap(
        center_lat: Double = 30.0,
        center_lon: Double = 5.0,
        zoom: Double = 1.7,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        chargers = DownloadTeslaChargers(
            use_mock = $.use_mock
        ) catch {
            yield BuildTeslaChargerMap(
                status = "failed",
                html_path = "",
                detail = "tesla charger download failed"
            )
        }
        map = BuildMap(
            region = "tesla",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            only_layers = "tesla",
            attribution_workflow = "save_earth.workflows.BuildTeslaChargerMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "Tesla charging stations worldwide (Superchargers + destination chargers), from OpenStreetMap. Click any charger for its full details (operator, capacity, socket types, opening hours, ...)."
        ) after chargers catch {
            yield BuildTeslaChargerMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildTeslaChargerMap(
            status = "completed",
            html_path = map.html_path,
            detail = "tesla map with " ++ chargers.feature_count ++ " charger(s)"
        )
    }

    /** Build an interactive world map of named research telescopes.
      *
      * Downloads the OSM telescope dataset, then renders the MapLibre map with
      * only the telescopes layer. No curated field list, so clicking a telescope
      * opens a popup table showing every OSM attribute (telescope:type,
      * telescope:diameter, operator, start_date, wikipedia, ...). */
    workflow BuildTelescopeMap(
        center_lat: Double = 25.0,
        center_lon: Double = 0.0,
        zoom: Double = 1.6,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        scopes = DownloadTelescopes(
            use_mock = $.use_mock
        ) catch {
            yield BuildTelescopeMap(
                status = "failed",
                html_path = "",
                detail = "telescope download failed"
            )
        }
        map = BuildMap(
            region = "telescopes",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            only_layers = "telescopes",
            attribution_workflow = "save_earth.workflows.BuildTelescopeMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "Named research telescopes worldwide (optical + radio), from OpenStreetMap. Click any telescope for its full details (type, diameter, operator, ...)."
        ) after scopes catch {
            yield BuildTelescopeMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildTelescopeMap(
            status = "completed",
            html_path = map.html_path,
            detail = "telescope map with " ++ scopes.feature_count ++ " telescope(s)"
        )
    }

    /** Seismic-hazard world map: recent earthquakes over the fault lines.
      *
      * Downloads recent significant earthquakes (USGS M4.5+, past 30 days) and
      * the tectonic plate boundaries (Bird 2002), then renders both on one map:
      * quakes as circles sized and coloured by magnitude, faults as lines.
      * BuildMap depends on both downloads via the summed feature counts. */
    workflow BuildSeismicMap(
        center_lat: Double = 20.0,
        center_lon: Double = 0.0,
        zoom: Double = 1.5,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        faults = DownloadFaults(
            use_mock = $.use_mock
        ) catch {
            yield BuildSeismicMap(
                status = "failed",
                html_path = "",
                detail = "fault-line download failed"
            )
        }
        quakes = DownloadEarthquakes(
            use_mock = $.use_mock
        ) catch {
            yield BuildSeismicMap(
                status = "failed",
                html_path = "",
                detail = "earthquake download failed"
            )
        }
        map = BuildMap(
            region = "seismic",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            only_layers = "faults,earthquakes",
            attribution_workflow = "save_earth.workflows.BuildSeismicMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "Recent earthquakes (USGS M4.5+, past 30 days), sized and coloured by magnitude, over the tectonic plate boundaries (the major global fault lines, Bird 2002). Quakes cluster along the boundaries. Click any quake or fault for its full details."
        ) after faults, quakes catch {
            yield BuildSeismicMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildSeismicMap(
            status = "completed",
            html_path = map.html_path,
            detail = "seismic map with " ++ quakes.feature_count ++ " quake(s)"
        )
    }

    /** World map of active fires / thermal anomalies detected in the past 24h.
      *
      * Downloads the merged NASA FIRMS feed (VIIRS 375 m + MODIS 1 km) and
      * renders it as three toggleable confidence bands, each circle sized by
      * fire radiative power. `after fires` because the render reads the cache
      * the download wrote and takes no value from it.
      *
      * `max_inline_features` caps how many detections reach the HTML. The cached
      * feed is FRP-sorted, so a cap keeps the most energetic detections rather
      * than an arbitrary slice -- but it IS a cap: the returned detail states
      * how many of how many are drawn. */
    workflow BuildWildfireMap(
        center_lat: Double = 20.0,
        center_lon: Double = 0.0,
        zoom: Double = 1.6,
        max_inline_features: Int = 40000,
        use_mock: Boolean = false
    ) => (
        status: String,
        html_path: String,
        detail: String
    ) andThen {
        fires = DownloadActiveFire(
            use_mock = $.use_mock
        ) catch {
            yield BuildWildfireMap(
                status = "failed",
                html_path = "",
                detail = "FIRMS active-fire download failed"
            )
        }
        map = BuildMap(
            region = "wildfire",
            center_lat = $.center_lat,
            center_lon = $.center_lon,
            zoom = $.zoom,
            only_layers = "fire-*",
            max_inline_features = $.max_inline_features,
            attribution_workflow = "save_earth.workflows.BuildWildfireMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "Active fire and thermal-anomaly detections from NASA FIRMS over the past 24 hours (VIIRS 375 m + MODIS 1 km), split into low, nominal and high confidence bands. Circle size scales with fire radiative power. IMPORTANT: these are thermal anomalies, not confirmed wildfires -- gas flares, industrial heat, active lava and agricultural burning all register identically, and the single strongest detection on a given day is often a volcano. Detections are limited by cloud cover and satellite overpass, so a blank area means nothing was detected, not that nothing is burning. Click any detection for its sensor, confidence, radiative power and acquisition time. For page weight the map draws only the strongest detections by radiative power (max_inline_features); the layer toggles show how many of each band are drawn, and the complete set is in the cached GeoJSON."
        ) after fires catch {
            yield BuildWildfireMap(
                status = "failed",
                html_path = "",
                detail = "map build failed"
            )
        }
        yield BuildWildfireMap(
            status = "completed",
            html_path = map.html_path,
            detail = fires.feature_count ++ " thermal anomalies detected " ++ fires.acquired_from ++ " to " ++ fires.acquired_to ++ " (" ++ fires.high_count ++ " high / " ++ fires.nominal_count ++ " nominal / " ++ fires.low_count ++ " low confidence); map draws " ++ map.layer_count ++ " band(s), strongest first"
        )
    }

    /** Fan out per country: fetch each country's semiconductor fabs as a
      * distributed task, accumulating the per-country cache paths. Cache-first
      * (force=false) so re-runs reuse cached countries and never re-query
      * Overpass; per-country failures are tolerated and just drop that country. */
    workflow FetchFabsByCountry(
        countries: Json = [],
        force: Boolean = false
    ) => (
        fab_paths: [String]
    ) andThen foreach c in $.countries {
        fab = DownloadFabsForCountry(
            country_iso2 = $.c.iso2,
            country_name = $.c.name,
            force = $.force
        )
        yield FetchFabsByCountry(fab_paths = [fab.relative_path])
    }

    /** Build a world map of semiconductor fabrication plants: enumerate every
      * admin-0 country, fan out per country over the OSM Overpass API, merge the
      * per-country results, and render a MapLibre point map whose popups show ALL
      * OSM tags for each plant. Cache-first by default. Publish to facetwork-maps
      * separately via census.workflows.PublishToSite (prefixes = [output_dir],
      * dests = ["world/semiconductor"]). */
    workflow BuildSemiconductorMap(
        force: Boolean = false
    ) => (
        status: String,
        html_path: String,
        output_dir: String,
        feature_count: Int,
        country_count: Int
    ) andThen {
        countries = ListFabCountries()
        fetched = FetchFabsByCountry(countries = countries.countries, force = $.force)
        wd = DownloadFabsWikidata(force = $.force)
        merged = MergeFabs(parts = fetched.fab_paths, wikidata_path = wd.relative_path)
        map = BuildMap(
            region = "semiconductor",
            center_lat = 30.0,
            center_lon = 80.0,
            zoom = 2.0,
            only_layers = "semiconductor-fabs",
            attribution_workflow = "save_earth.workflows.BuildSemiconductorMap",
            attribution_ffl_url = "https://github.com/rlemke/fwh_save_earth/blob/main/src/save_earth/ffl/save_earth.ffl",
            description = "Semiconductor fabrication plants worldwide, combining OpenStreetMap (industrial=semiconductor / man_made=works + product) and Wikidata (semiconductor fabrication plants, with operator / country / inception / owner). Each plant's popup shows its source fields. Open-data coverage is sparse and uneven (many fabs are unmapped); the two sources are unioned for fuller coverage."
        ) after merged
        yield BuildSemiconductorMap(
            status = "completed",
            html_path = map.html_path,
            output_dir = map.output_dir,
            feature_count = merged.feature_count,
            country_count = merged.country_count
        )
    }
}
